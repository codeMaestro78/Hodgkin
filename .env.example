APP_ENV=development
# INFO retains lifecycle/failures; DEBUG adds per-request/transaction diagnostics.
RESEARCH_LOG_LEVEL=INFO
DATABASE_SLOW_STATEMENT_MS=1000
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
RESEARCH_API_URL=http://localhost:8000
# Use the Supabase Session Pooler URL from Dashboard. Encode special characters
# in the password, keep sslmode=require, and use the generated /postgres database.
DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:URL_ENCODED_PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_ADMIN_URL=
DATABASE_POOL_SIZE=5
REDIS_URL=rediss://default:URL_ENCODED_PASSWORD@REDIS_HOST:REDIS_PORT/0
SSE_REDIS_WAKEUPS_ENABLED=true
# Optional and off by default. Inputs/outputs are hidden and trace metadata/errors are redacted.
LANGSMITH_TRACING_ENABLED=false
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=research-api
LANGGRAPH_CHECKPOINTER=postgres
WORKER_CONCURRENCY_LIMIT=3
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini
# Add only the credentials you use to your private .env file; do not leave
# blank assignments because empty secret values are easy to mistake for keys.
# OPENAI_API_KEY=...
# OPENROUTER_API_KEY=...
# TAVILY_API_KEY=...
# SERPER_API_KEY=...
# Opt-in for newly enqueued jobs only; saved jobs retain their route.
SERPER_DISCOVERY_ENABLED=false
OPENALEX_DISCOVERY_ENABLED=false
# OPENALEX_API_KEY=...
# New explicit-mode jobs do not run automatic bounded repair unless enabled.
BOUNDED_GAP_REPAIR_ENABLED=false
# Requires migration 0021; records provisional mode weights only, never enforces quota.
BILLING_SHADOW_ACCOUNTING_ENABLED=false
BILLING_ENFORCEMENT_ENABLED=false
BILLING_OPERATOR_TOKENS=
BILLING_STRIPE_ENABLED=false
# Keep disabled: fulfillment, wallet spending, legal review, and release validation are incomplete.
BILLING_CREDIT_TOPUPS_ENABLED=false
BILLING_CREDIT_TERMS_APPROVED=false
# Approved local product-policy identifier; do not set as approved until customer/legal terms are ready.
BILLING_CREDIT_TERMS_VERSION=
BILLING_CREDIT_FULFILLMENT_ENABLED=false
BILLING_CREDIT_SPENDING_ENABLED=false
BILLING_CREDIT_MAX_WALLET_UNITS=0
BILLING_CREDIT_PACKS_JSON=[]
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=
STRIPE_PRICE_SCHOLAR_MONTHLY=
STRIPE_PRICE_INVESTIGATOR_MONTHLY=
STRIPE_PORTAL_CONFIGURATION_ID=
STRIPE_LIVEMODE=false
BILLING_LIVE_LAUNCH_APPROVED=false
BILLING_APP_BASE_URL=http://localhost:3000
DISCOVERY_RETRY_AFTER_MAX_SECONDS=5
# PARALLEL_API_KEY=...
# TYPESAFE_API_KEY=...
INTERNAL_SERVICE_AUTH=replace-with-a-long-random-server-only-shared-secret
OBJECT_STORAGE_ENDPOINT=http://localhost:54566
OBJECT_STORAGE_BUCKET=research-artifacts
OBJECT_STORAGE_ACCESS_KEY=test
OBJECT_STORAGE_SECRET_KEY=test
OBJECT_STORAGE_REGION=us-east-1
ARTIFACT_RETENTION_DAYS=30
SSE_HEARTBEAT_INTERVAL_MS=20000
OTEL_EXPORTER_ENDPOINT=
EVAL_BENCHMARK_PATH=evals/release-20.jsonl
EVAL_SCHEDULE_CRON=0 3 * * *


