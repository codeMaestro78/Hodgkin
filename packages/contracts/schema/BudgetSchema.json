{
  "$id": "https://schemas.research.local/1.4/BudgetSchema.json",
  "title": "BudgetSchema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "maxWallClockMs": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 1800000
    },
    "maxSearchCalls": {
      "default": 12,
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "maxBrowserSessions": {
      "default": 0,
      "type": "integer",
      "minimum": 0,
      "maximum": 5
    },
    "maxReflectionRounds": {
      "default": 1,
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "maxInputTokens": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxOutputTokens": {
      "type": "integer",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991
    },
    "maxEstimatedCostUsd": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "maxWallClockMs",
    "maxSearchCalls",
    "maxBrowserSessions",
    "maxReflectionRounds",
    "maxInputTokens",
    "maxOutputTokens",
    "maxEstimatedCostUsd"
  ],
  "additionalProperties": false
}
