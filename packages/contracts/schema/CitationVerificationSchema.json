{
  "$id": "https://schemas.research.local/1.2/CitationVerificationSchema.json",
  "title": "CitationVerificationSchema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "exactSpan": {
      "type": "object",
      "properties": {
        "verified": {
          "type": "boolean"
        },
        "evidenceArtifactHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "startChar": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "endChar": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "verified",
        "evidenceArtifactHash",
        "startChar",
        "endChar"
      ],
      "additionalProperties": false
    },
    "semanticSupport": {
      "type": "object",
      "properties": {
        "verdict": {
          "type": "string",
          "enum": [
            "supports",
            "partially_supports",
            "contradicts",
            "unrelated"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "verifierModel": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "verifierVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        }
      },
      "required": [
        "verdict",
        "confidence",
        "verifierModel",
        "verifierVersion"
      ],
      "additionalProperties": false
    },
    "verifiedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "exactSpan",
    "semanticSupport",
    "verifiedAt"
  ],
  "additionalProperties": false
}
