{
  "$id": "https://schemas.research.local/1.2/CreateResearchRunRequestSchema.json",
  "title": "CreateResearchRunRequestSchema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "question": {
      "type": "string",
      "minLength": 5,
      "maxLength": 10000
    },
    "reportRequirements": {
      "default": [],
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "budgetOverrides": {
      "type": "object",
      "properties": {
        "maxWallClockMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1800000
        },
        "maxSearchCalls": {
          "default": 12,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "maxBrowserSessions": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "maxReflectionRounds": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "maxInputTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxEstimatedCostUsd": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 200
    }
  },
  "required": [
    "question",
    "reportRequirements"
  ],
  "additionalProperties": false
}
