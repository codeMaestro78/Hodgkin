{
  "$id": "https://schemas.research.local/1.7/CreateResearchRunResponseSchema.json",
  "title": "CreateResearchRunResponseSchema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "focused",
            "balanced",
            "deep"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "modePolicyVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "modeResolution": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "explicit",
            "legacy-inferred"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "status": {
      "type": "string",
      "const": "queued"
    }
  },
  "required": [
    "runId",
    "status"
  ],
  "additionalProperties": false
}
