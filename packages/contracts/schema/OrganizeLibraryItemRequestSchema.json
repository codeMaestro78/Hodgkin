{
  "$id": "https://schemas.research.local/1.6/OrganizeLibraryItemRequestSchema.json",
  "title": "OrganizeLibraryItemRequestSchema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "projectId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "tags": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 40
      }
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "projectId",
    "tags",
    "notes"
  ],
  "additionalProperties": false
}
