{
  "$id": "https://schemas.research.local/1.4/PublicClaimCheckSchema.json",
  "title": "PublicClaimCheckSchema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "claim": {
      "type": "string",
      "maxLength": 1200
    },
    "caveats": {
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "reportId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "section": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 300
        },
        {
          "type": "null"
        }
      ]
    },
    "publishedInReport": {
      "type": "boolean"
    },
    "method": {
      "type": "string",
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "supported",
        "partially_supported",
        "contradicted",
        "insufficient_evidence",
        "not_checked"
      ]
    },
    "supportingSourceIds": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "contradictingSourceIds": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "citations": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "sourceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "quote": {
            "type": "string",
            "maxLength": 600
          },
          "exactSpanVerified": {
            "type": "boolean"
          },
          "verdict": {
            "type": "string",
            "enum": [
              "supports",
              "partially_supports",
              "contradicts",
              "unrelated",
              "not_recorded"
            ]
          },
          "context": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1200
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "sourceId",
          "quote",
          "exactSpanVerified",
          "verdict",
          "context"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "claim",
    "caveats",
    "reportId",
    "section",
    "publishedInReport",
    "method",
    "status",
    "supportingSourceIds",
    "contradictingSourceIds",
    "citations"
  ],
  "additionalProperties": false
}
