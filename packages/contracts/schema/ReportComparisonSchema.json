    "textDiff": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "available",
            "size_limit"
          ]
        },
        "unified": {
          "type": "string",
          "maxLength": 120000
        }
      },
      "required": [
        "status",
        "unified"
      ],
      "additionalProperties": false
    },
    "limitations": {
      "minItems": 1,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "string",
