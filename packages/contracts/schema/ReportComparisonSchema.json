        "sharedContentHashes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 320
        }
      },
      "required": [
        "left",
        "right",
        "sharedUrls",
        "sharedContentHashes"
      ],
      "additionalProperties": false
