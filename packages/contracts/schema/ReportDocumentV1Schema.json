{
  "$id": "https://schemas.research.local/1.4/ReportDocumentV1Schema.json",
  "title": "ReportDocumentV1Schema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 1
    },
    "assessmentVersion": {
      "type": "string",
      "const": "evidence-links-v1"
    },
    "mode": {
      "type": "string",
      "enum": [
        "focused",
        "balanced",
        "deep"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "sections": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "overview",
              "mechanisms",
              "comparison",
              "risks",
              "implications"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "claimIds": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "id",
          "title",
          "claimIds"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "section": {
            "type": "string",
            "enum": [
              "overview",
              "mechanisms",
              "comparison",
              "risks",
              "implications"
            ]
          },
          "citationIds": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "sourceIds": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "id",
          "text",
          "section",
          "citationIds",
          "sourceIds"
        ],
        "additionalProperties": false
      }
    },
    "requirements": {
      "minItems": 1,
      "maxItems": 21,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "const": "question"
              },
              "origin": {
                "type": "string",
                "const": "main_question"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "status": {
                "type": "string",
                "enum": [
                  "addressed",
                  "unresolved"
                ]
              },
              "claimIds": {
                "maxItems": 40,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "basis": {
                "type": "string",
                "enum": [
                  "model_linked_verified_findings",
                  "not_established"
                ]
              }
            },
            "required": [
              "id",
              "origin",
              "text",
              "status",
              "claimIds",
              "basis"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^requirement-([1-9]|1[0-9]|20)$"
              },
              "origin": {
                "type": "string",
                "const": "user_requirement"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              },
              "status": {
                "type": "string",
                "enum": [
                  "addressed",
                  "unresolved"
                ]
              },
              "claimIds": {
                "maxItems": 40,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "basis": {
                "type": "string",
                "enum": [
                  "model_linked_verified_findings",
                  "not_established"
                ]
              }
            },
            "required": [
              "id",
              "origin",
              "text",
              "status",
              "claimIds",
              "basis"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "questionCoverage": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "status": {
            "type": "string",
            "enum": [
              "addressed",
              "unresolved"
            ]
          },
          "claimIds": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "basis": {
            "type": "string",
            "enum": [
              "collection_provenance",
              "not_established"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "status",
          "claimIds",
          "basis"
        ],
        "additionalProperties": false
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "answered",
            "partial",
            "insufficient_evidence"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "verifiedFindings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "excludedFindings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "status",
        "reason",
        "verifiedFindings",
        "excludedFindings"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "assessmentVersion",
    "mode",
    "title",
    "sections",
    "findings",
    "requirements",
    "questionCoverage",
    "quality"
  ],
  "additionalProperties": false
}
