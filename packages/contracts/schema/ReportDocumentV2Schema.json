{
  "$id": "https://schemas.research.local/1.6/ReportDocumentV2Schema.json",
  "title": "ReportDocumentV2Schema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "assessmentVersion": {
      "type": "string",
      "const": "coverage-ledger-v1"
    },
    "mode": {
      "type": "string",
      "enum": [
        "focused",
        "balanced",
        "deep"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "sections": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "overview",
              "mechanisms",
              "comparison",
              "risks",
              "implications"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "claimIds": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "id",
          "title",
          "claimIds"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1200
          },
          "section": {
            "type": "string",
            "enum": [
              "overview",
              "mechanisms",
              "comparison",
              "risks",
              "implications"
            ]
          },
          "citationIds": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "sourceIds": {
            "minItems": 1,
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "id",
          "text",
          "section",
          "citationIds",
          "sourceIds"
        ],
        "additionalProperties": false
      }
    },
    "requirements": {
      "minItems": 1,
      "maxItems": 21,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "const": "question"
              },
              "origin": {
                "type": "string",
                "const": "main_question"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 10000
              },
              "status": {
                "type": "string",
                "enum": [
                  "addressed",
                  "unresolved"
                ]
              },
              "claimIds": {
                "maxItems": 40,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "basis": {
                "type": "string",
                "enum": [
                  "model_linked_verified_findings",
                  "not_established"
                ]
              }
            },
            "required": [
              "id",
              "origin",
              "text",
              "status",
              "claimIds",
              "basis"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^requirement-([1-9]|1[0-9]|20)$"
              },
              "origin": {
                "type": "string",
                "const": "user_requirement"
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500,
                "pattern": "\\S"
              },
              "status": {
                "type": "string",
                "enum": [
                  "addressed",
                  "unresolved"
                ]
              },
              "claimIds": {
                "maxItems": 40,
                "type": "array",
                "items": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                }
              },
              "basis": {
                "type": "string",
                "enum": [
                  "model_linked_verified_findings",
                  "not_established"
                ]
              }
            },
            "required": [
              "id",
              "origin",
              "text",
              "status",
              "claimIds",
              "basis"
            ],
            "additionalProperties": false
          }
        ]
      }
    },
    "questionCoverage": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          },
          "status": {
            "type": "string",
            "enum": [
              "addressed",
              "unresolved"
            ]
          },
          "claimIds": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "basis": {
            "type": "string",
            "enum": [
              "collection_provenance",
              "not_established"
            ]
          }
        },
        "required": [
          "id",
          "text",
          "status",
          "claimIds",
          "basis"
        ],
        "additionalProperties": false
      }
    },
    "quality": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "partial",
            "insufficient_evidence"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "verifiedFindings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 40
        },
        "excludedFindings": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "status",
        "reason",
        "verifiedFindings",
        "excludedFindings"
      ],
      "additionalProperties": false
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "planId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "assessmentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "modePolicyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "dimensions": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "requirementIds": {
            "minItems": 1,
            "maxItems": 21,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(question|requirement-([1-9]|1[0-9]|20))$"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "searching",
              "evidence_found",
              "verified_covered",
              "unresolved",
              "blocked"
            ]
          },
          "claimIds": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "basis": {
            "type": "string",
            "enum": [
              "criterion-review-v1",
              "not_assessed"
            ]
          },
          "criteria": {
            "minItems": 1,
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "met",
                    "partial",
                    "not_met",
                    "unknown"
                  ]
                },
                "claimIds": {
                  "maxItems": 40,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "criterion-review-v1",
                    "not_assessed"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "pattern": "\\S"
                }
              },
              "required": [
                "id",
                "outcome",
                "claimIds",
                "basis",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "requirementIds",
          "status",
          "claimIds",
          "reason",
          "basis",
          "criteria"
        ],
        "additionalProperties": false
      }
    },
    "requirementOutcomes": {
      "minItems": 1,
      "maxItems": 21,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(question|requirement-([1-9]|1[0-9]|20))$"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "established",
              "partially_established",
              "not_established",
              "not_assessed"
            ]
          },
          "dimensionIds": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "claimIds": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "outcome",
          "dimensionIds",
          "claimIds",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "comparisons": {
      "default": [],
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimensionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "cells": {
            "minItems": 2,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "alternative": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "supported",
                    "not_established"
                  ]
                },
                "claimIds": {
                  "maxItems": 40,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                }
              },
              "required": [
                "alternative",
                "status",
                "claimIds"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "dimensionId",
          "cells"
        ],
        "additionalProperties": false
      }
    },
    "sourceIndependence": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "unknown"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "version",
    "assessmentVersion",
    "mode",
    "title",
    "sections",
    "findings",
    "requirements",
    "questionCoverage",
    "quality",
    "runId",
    "planId",
    "assessmentId",
    "modePolicyVersion",
    "dimensions",
    "requirementOutcomes",
    "comparisons",
    "sourceIndependence"
  ],
  "additionalProperties": false
}
