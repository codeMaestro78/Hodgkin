        "balanced",
        "deep"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    },
    "sections": {
      "minItems": 5,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "overview",
              "mechanisms",
              "comparison",
              "risks",
              "implications"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "claimIds": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          }
        },
        "required": [
          "id",
          "title",
          "claimIds"
        ],
        "additionalProperties": false
      }
    },
    "findings": {
      "maxItems": 40,
      "type": "array",
