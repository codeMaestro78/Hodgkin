{
  "$id": "https://schemas.research.local/1.7/ReportDocumentV6Schema.json",
  "title": "ReportDocumentV6Schema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
