    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "planId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "assessmentId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "modePolicyVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "\\S"
    },
    "dimensions": {
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "requirementIds": {
            "minItems": 1,
            "maxItems": 21,
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(question|requirement-([1-9]|1[0-9]|20))$"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "searching",
              "evidence_found",
              "verified_covered",
              "unresolved",
              "blocked"
            ]
          },
          "claimIds": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          },
          "basis": {
            "type": "string",
            "enum": [
              "criterion-review-v1",
              "not_assessed"
            ]
          },
          "criteria": {
            "minItems": 1,
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "outcome": {
                  "type": "string",
                  "enum": [
                    "met",
                    "partial",
                    "not_met",
                    "unknown"
                  ]
                },
                "claimIds": {
                  "maxItems": 40,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                },
                "basis": {
                  "type": "string",
                  "enum": [
                    "criterion-review-v1",
                    "not_assessed"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1000,
                  "pattern": "\\S"
                }
              },
              "required": [
                "id",
                "outcome",
                "claimIds",
                "basis",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "label",
          "requirementIds",
          "status",
          "claimIds",
          "reason",
          "basis",
          "criteria"
        ],
        "additionalProperties": false
      }
    },
    "requirementOutcomes": {
      "minItems": 1,
      "maxItems": 21,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^(question|requirement-([1-9]|1[0-9]|20))$"
          },
          "outcome": {
            "type": "string",
            "enum": [
              "established",
              "partially_established",
              "not_established",
              "not_assessed"
            ]
          },
          "dimensionIds": {
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "claimIds": {
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000,
            "pattern": "\\S"
          }
        },
        "required": [
          "id",
          "outcome",
          "dimensionIds",
          "claimIds",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "comparisons": {
      "default": [],
      "maxItems": 32,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "dimensionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "cells": {
            "minItems": 2,
            "maxItems": 20,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "alternative": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "supported",
                    "not_established"
                  ]
                },
                "claimIds": {
                  "maxItems": 40,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  }
                }
              },
              "required": [
                "alternative",
                "status",
                "claimIds"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "dimensionId",
          "cells"
        ],
        "additionalProperties": false
      }
    },
    "sourceIndependence": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "const": "unknown"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000,
          "pattern": "\\S"
        }
      },
      "required": [
        "status",
        "reason"
      ],
      "additionalProperties": false
    },
    "sourceRelationships": {
      "maxItems": 190,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fromSourceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "toSourceId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "same_content",
              "same_work",
              "same_publisher"
            ]
          },
          "confidence": {
            "type": "string",
            "const": "observed"
          },
          "basis": {
            "type": "string",
            "enum": [
              "observed_content_hash_match",
              "observed_doi_match",
              "verified_publisher_metadata_match"
            ]
          },
          "identifier": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2500
          }
        },
        "required": [
          "fromSourceId",
          "toSourceId",
          "kind",
          "confidence",
          "basis"
        ],
        "additionalProperties": false
      }
    },
    "conflicts": {
      "maxItems": 128,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "dimensionId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "criterionIds": {
            "minItems": 1,
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "claimIds": {
            "minItems": 2,
            "maxItems": 40,
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
            }
          },
          "status": {
            "type": "string",
            "const": "potential"
          },
          "basis": {
            "type": "string",
            "const": "criterion-review-v1"
          },
          "reason": {
            "type": "string",
            "const": "Independent criterion review nominated a potential disagreement."
          }
        },
        "required": [
          "id",
          "dimensionId",
          "criterionIds",
          "claimIds",
          "status",
          "basis",
          "reason"
        ],
        "additionalProperties": false
      }
    },
    "narrative": {
      "type": "object",
      "properties": {
        "basis": {
          "type": "string",
          "const": "narrative-composition-v1"
        },
        "status": {
          "type": "string",
          "enum": [
            "composed",
            "not_composed"
          ]
        },
        "reason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "no_verified_findings",
                "insufficient_time",
                "writer_unavailable",
                "composition_failed",
                "no_supported_sentences"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "blocks": {
          "maxItems": 14,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^narrative-([1-9]|1[0-4])$"
              },
              "role": {
                "type": "string",
                "enum": [
                  "answer",
                  "dimension",
                  "synthesis",
                  "tradeoffs",
                  "implications"
                ]
              },
              "dimensionId": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sentences": {
                "minItems": 1,
                "maxItems": 8,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "claimId": {
