{
  "$id": "https://schemas.research.local/1.5/ResearchRunProjectionSchema.json",
  "title": "ResearchRunProjectionSchema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "mode": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "focused",
            "balanced",
            "deep"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "modePolicyVersion": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "modeResolution": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "explicit",
            "legacy-inferred"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5"
      ]
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "userId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "planning",
        "awaiting_approval",
        "researching",
        "verifying",
        "reflecting",
        "writing",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "originalQuestion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 10000
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxWallClockMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1800000
        },
        "maxSearchCalls": {
          "default": 12,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "maxProviderOperations": {
          "type": "integer",
          "minimum": 2,
          "maximum": 50
        },
        "maxSources": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20
        },
        "maxBrowserSessions": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "maxReflectionRounds": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "maxInputTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxEstimatedCostUsd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "maxWallClockMs",
        "maxSearchCalls",
        "maxBrowserSessions",
        "maxReflectionRounds",
        "maxInputTokens",
        "maxOutputTokens",
        "maxEstimatedCostUsd"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "searchCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "browserSessions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "estimatedCostUsd": {
          "type": "number",
          "minimum": 0
        },
        "reservedSearchCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reservedEstimatedCostUsd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "searchCalls",
        "browserSessions",
        "inputTokens",
        "outputTokens",
        "estimatedCostUsd",
        "reservedSearchCalls",
        "reservedEstimatedCostUsd"
      ],
      "additionalProperties": false
    },
    "planVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sourceCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "evidenceClaimCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "gapCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "reportId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cancellationRequestedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cancelledAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "tenantId",
    "userId",
    "status",
    "originalQuestion",
    "budget",
    "usage",
    "planVersion",
    "sourceCount",
    "evidenceClaimCount",
    "gapCount",
    "reportId",
    "cancellationRequestedAt",
    "cancelledAt",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
