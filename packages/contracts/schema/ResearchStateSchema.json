{
  "$id": "https://schemas.research.local/1.2/ResearchStateSchema.json",
  "title": "ResearchStateSchema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "enum": [
        "1.1",
        "1.2"
      ]
    },
    "runId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "tenantId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "userId": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "threadId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "planning",
        "researching",
        "verifying",
        "reflecting",
        "writing",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "originalQuestion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 10000
    },
    "normalizedQuestion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 5000
    },
    "reportRequirements": {
      "maxItems": 20,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 500
      }
    },
    "activePlanId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "planVersion": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "subQuestionIds": {
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "sourceIds": {
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "evidenceClaimIds": {
      "maxItems": 300,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "gapIds": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
      }
    },
    "reflectionRound": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "concurrencyLimit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16
    },
    "reflectionDecision": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "type": "string",
              "enum": [
                "1.1",
                "1.2"
              ]
            },
            "decision": {
              "type": "string",
              "enum": [
                "continue",
                "synthesize",
                "incomplete"
              ]
            },
            "rationale": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2000
            },
            "materialGaps": {
              "maxItems": 4,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "schemaVersion": {
                    "type": "string",
                    "enum": [
                      "1.1",
                      "1.2"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "tenantId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "runId": {
                    "type": "string",
                    "format": "uuid",
                    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 1000
                  },
                  "severity": {
                    "type": "string",
                    "enum": [
                      "low",
                      "medium",
                      "high"
                    ]
                  },
                  "suggestedQuery": {
                    "anyOf": [
                      {
                        "type": "string",
                        "maxLength": 500
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "resolved": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "schemaVersion",
                  "id",
                  "tenantId",
                  "runId",
                  "description",
                  "severity",
                  "suggestedQuery",
                  "resolved"
                ],
                "additionalProperties": false
              }
            },
            "expectedMarginalGain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "schemaVersion",
            "decision",
            "rationale",
            "materialGaps",
            "expectedMarginalGain"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "budget": {
      "type": "object",
      "properties": {
        "maxWallClockMs": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 1800000
        },
        "maxSearchCalls": {
          "default": 12,
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "maxBrowserSessions": {
          "default": 0,
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "maxReflectionRounds": {
          "default": 1,
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "maxInputTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxOutputTokens": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "maxEstimatedCostUsd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "maxWallClockMs",
        "maxSearchCalls",
        "maxBrowserSessions",
        "maxReflectionRounds",
        "maxInputTokens",
        "maxOutputTokens",
        "maxEstimatedCostUsd"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "searchCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "browserSessions": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "estimatedCostUsd": {
          "type": "number",
          "minimum": 0
        },
        "reservedSearchCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reservedEstimatedCostUsd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "searchCalls",
        "browserSessions",
        "inputTokens",
        "outputTokens",
        "estimatedCostUsd",
        "reservedSearchCalls",
        "reservedEstimatedCostUsd"
      ],
      "additionalProperties": false
    },
    "reportId": {
      "anyOf": [
        {
          "type": "string",
          "format": "uuid",
          "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cancellationRequestedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "cancelledAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
        },
        {
          "type": "null"
        }
      ]
    },
    "errorCode": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    }
  },
  "required": [
    "schemaVersion",
    "runId",
    "tenantId",
    "userId",
    "threadId",
    "status",
    "originalQuestion",
    "normalizedQuestion",
    "reportRequirements",
    "activePlanId",
    "planVersion",
    "subQuestionIds",
    "sourceIds",
    "evidenceClaimIds",
    "gapIds",
    "reflectionRound",
    "concurrencyLimit",
    "reflectionDecision",
    "budget",
    "usage",
    "reportId",
    "cancellationRequestedAt",
    "cancelledAt",
    "errorCode",
    "createdAt",
    "updatedAt"
  ],
  "additionalProperties": false
}
