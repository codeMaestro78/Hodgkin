{
  "$id": "https://schemas.research.local/1.6/RetrievalAccountingSchema.json",
  "title": "RetrievalAccountingSchema",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.1"
    },
    "providers": {
      "maxItems": 8,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "openalex",
              "serper",
              "tavily",
              "parallel",
              "browser",
              "internal"
            ]
          },
          "searchCalls": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "discovered": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "shortlisted": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "excluded": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "duplicateWork": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "unavailable": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "policyVersions": {
            "maxItems": 10,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            }
          },
          "countsComplete": {
            "type": "boolean"
          },
          "extractedSources": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "citedInVerifiedFinding": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "provider",
          "searchCalls",
          "discovered",
          "shortlisted",
          "excluded",
          "duplicateWork",
          "unavailable",
          "policyVersions",
          "countsComplete",
          "extractedSources",
          "citedInVerifiedFinding"
        ],
        "additionalProperties": false
      }
    },
    "extractionCalls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "extractionOutcomes": {
      "type": "object",
      "properties": {
        "succeeded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "uncertain": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "pending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "other": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "succeeded",
        "failed",
        "uncertain",
        "pending",
        "other"
      ],
      "additionalProperties": false
    },
    "extractedSources": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "citedInVerifiedFinding": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "citationChecks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exactSpanVerifiedCitations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "semanticReviewOutcomes": {
      "type": "object",
      "properties": {
        "supports": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "partially_supports": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "contradicts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unrelated": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "notRecorded": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "supports",
        "partially_supports",
        "contradicts",
        "unrelated",
        "notRecorded"
      ],
      "additionalProperties": false
    },
    "publishedClaims": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "answerUsefulness": {
      "type": "string",
      "const": "not_assessed"
    },
    "dimensionRelevance": {
      "type": "string",
      "const": "not_assessed"
    },
    "sourceIndependence": {
      "type": "string",
      "const": "not_assessed"
    }
  },
  "required": [
    "schemaVersion",
    "providers",
    "extractionCalls",
    "extractionOutcomes",
    "extractedSources",
    "citedInVerifiedFinding",
    "citationChecks",
    "exactSpanVerifiedCitations",
    "semanticReviewOutcomes",
    "publishedClaims",
    "answerUsefulness",
    "dimensionRelevance",
    "sourceIndependence"
  ],
  "additionalProperties": false
}
