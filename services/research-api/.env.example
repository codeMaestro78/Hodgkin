APP_ENV=development
RESEARCH_LOG_LEVEL=INFO
DATABASE_SLOW_STATEMENT_MS=1000
# Opt-in: log every SQL command's static family and duration at DEBUG (never SQL text).
DATABASE_QUERY_TIMING_ENABLED=false
DATABASE_URL=postgresql+psycopg://research_app:research_app@localhost:55432/research
DATABASE_ADMIN_URL=
# Put migration-owner credentials in .env.migrations, not this runtime file.
DATABASE_POOL_SIZE=5
# Apply migration 0007 before starting workers. Tests keep the dispatcher off.
DISPATCHER_ENABLED=true
WORKER_CONCURRENCY=2
WORKER_LEASE_SECONDS=60
MAX_PENDING_RUNS_PER_TENANT=32
# Redis-backed API limits are shared across API replicas. Defaults: 120 reads,
# 30 mutations, and 4 research starts per account per minute.
HTTP_RATE_LIMIT_ENABLED=true
HTTP_RATE_LIMIT_GENERAL_PER_MINUTE=120
HTTP_RATE_LIMIT_MUTATION_PER_MINUTE=30
HTTP_RATE_LIMIT_RESEARCH_START_PER_MINUTE=4
HTTP_RATE_LIMIT_WEBHOOK_PER_MINUTE=300
REDIS_URL=redis://localhost:56379/0
# Optional cross-process SSE hints; PostgreSQL replay/polling works without Redis.
SSE_REDIS_WAKEUPS_ENABLED=true
# Optional LangSmith traces. Inputs, outputs, and unapproved metadata are redacted.
LANGSMITH_TRACING_ENABLED=false
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=research-api
LLM_PROVIDER=openai
LLM_MODEL_NAME=gpt-4o-mini
# Optional per-role overrides; unset roles inherit LLM_PROVIDER / LLM_MODEL_NAME.
# The deterministic coverage reflector does not make a model call.
# LLM_PLANNER_PROVIDER=
# LLM_PLANNER_MODEL_NAME=
# LLM_WRITER_PROVIDER=
# LLM_WRITER_MODEL_NAME=
# LLM_CLAIM_REVIEW_PROVIDER=
# LLM_CLAIM_REVIEW_MODEL_NAME=
# One retry owner; SDK retries are disabled. Ambiguous dispatched calls are not retried.
PROVIDER_MAX_ATTEMPTS=3
PROVIDER_TIMEOUT_SECONDS=30
# A single writer call may need more generation time; this is not a retry.
MODEL_WRITER_TIMEOUT_SECONDS=60
# Add only the credentials you use to your private .env file; do not leave
# blank assignments because empty secret values are easy to mistake for keys.
# OPENAI_API_KEY=...
# OPENROUTER_API_KEY=...
# TAVILY_API_KEY=...
# SERPER_API_KEY=...
# Opt-in for newly enqueued jobs only; saved jobs retain their route.
SERPER_DISCOVERY_ENABLED=false
OPENALEX_DISCOVERY_ENABLED=false
# OPENALEX_API_KEY=...
# New explicit-mode jobs do not run automatic bounded repair unless enabled.
BOUNDED_GAP_REPAIR_ENABLED=false
TECHNICAL_RESULTS_ENABLED=false
SOURCE_MEASUREMENTS_ENABLED=false
# Requires migration 0021; records provisional mode weights only, never enforces quota.
BILLING_SHADOW_ACCOUNTING_ENABLED=false
BILLING_ENFORCEMENT_ENABLED=false
# JSON mapping operator UUIDs to unique secrets, for example {"00000000-0000-0000-0000-000000000001":"replace-me"}
BILLING_OPERATOR_TOKENS=
# Razorpay Standard Checkout and subscriptions are disabled by default.
BILLING_RAZORPAY_ENABLED=false
BILLING_SUBSCRIPTIONS_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_LIVEMODE=false
# Create these four INR plans in the Razorpay dashboard; app verifies amount/currency/interval.
# Proposed test values: Scholar ₹599/month, ₹5,999/year; Investigator ₹1,299/month, ₹12,999/year.
# Prices remain a proposal; keep BILLING_SUBSCRIPTIONS_ENABLED=false until test lifecycle review.
RAZORPAY_PLAN_SCHOLAR_MONTHLY=
RAZORPAY_PLAN_INVESTIGATOR_MONTHLY=
RAZORPAY_PLAN_SCHOLAR_YEARLY=
RAZORPAY_PLAN_INVESTIGATOR_YEARLY=
# Keep false until live payment launch is explicitly approved.
BILLING_LIVE_LAUNCH_APPROVED=false
# Razorpay checkout is INR-only. amountMinor is paise (100 paise = ₹1).
# INR example: [{"key":"starter","amountMinor":19900,"currency":"INR","units":5,"expiryDays":null}]
RAZORPAY_CREDIT_PACKS_JSON=[]
# Keep all purchase features off until test-mode checkout, webhooks, refunds/disputes, and spending are verified.
BILLING_CREDIT_TOPUPS_ENABLED=false
BILLING_CREDIT_TERMS_APPROVED=false
# Code accepts only research-credit-terms-v1; this setting does not itself approve customer-facing terms.
BILLING_CREDIT_TERMS_VERSION=
BILLING_CREDIT_FULFILLMENT_ENABLED=false
BILLING_CREDIT_SPENDING_ENABLED=false
BILLING_CREDIT_MAX_WALLET_UNITS=0
DISCOVERY_RETRY_AFTER_MAX_SECONDS=5
OBJECT_STORAGE_ENDPOINT=http://localhost:54566
OBJECT_STORAGE_BUCKET=research-artifacts
OBJECT_STORAGE_ACCESS_KEY=test
OBJECT_STORAGE_SECRET_KEY=test
OBJECT_STORAGE_REGION=us-east-1
ARTIFACT_RETENTION_DAYS=30
INTERNAL_SERVICE_AUTH=replace-with-a-long-random-server-only-shared-secret
SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
