{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "bindings": [
        {
          "type": "service",
          "service": "research-api",
          "format": "url",
          "env": "RESEARCH_API_URL"
        }
      ]
    },
    "research-api": {
      "root": "services/research-api",
      "framework": "fastapi",
      "entrypoint": "research_api.main:app",
      "installCommand": "uv sync --frozen --no-dev"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "web"
      }
    }
  ],
  "daemons": {
    "research-worker": {
      "root": "services/research-api",
      "entrypoint": "Dockerfile",
      "command": ["python", "-m", "research_api.worker"],
      "instances": {
        "bom1": 1
      },
      "terminationGracePeriodSeconds": 60
    }
  }
}
